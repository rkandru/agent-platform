{
  "_comment": "One per agent. Replace TEAM / AGENT. Generated from the Agent CR labels in CI (D6).",
  "clientId": "agent-TEAM-AGENT",
  "name": "Agent TEAM/AGENT",
  "description": "owner=TEAM tier=T1",
  "enabled": true,
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "standardFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "clientAuthenticatorType": "federated-jwt",
  "attributes": {
    "jwt.credential.issuer": "k8s-prod",
    "jwt.credential.sub": "system:serviceaccount:team-TEAM:AGENT",
    "standard.token.exchange.enabled": "true",
    "access.token.lifespan": "300"
  },
  "fullScopeAllowed": false,
  "defaultClientScopes": ["groups"],
  "optionalClientScopes": ["mcp-grafana", "mcp-github"],
  "protocolMappers": [
    {
      "name": "agent_id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": { "claim.name": "agent_id", "claim.value": "team-TEAM/AGENT", "jsonType.label": "String", "access.token.claim": "true" }
    }
  ]
}
